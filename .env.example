# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
SUPABASE_ATTACHMENTS_BUCKET=crm-email-attachments
ATTACHMENTS_CLEANUP_SECRET=replace-with-a-separate-long-random-secret
CAMPAIGNS_RUNNER_SECRET=replace-with-another-long-random-secret

# Gmail OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Envios Inteligentes (bucket privado separado)
SMART_SEND_BUCKET=crm-smart-documents
# Cloudflare Access: proteger todo o CRM, validar JWT e mapear o operador no servidor.
SMART_SEND_ACCESS_ISSUER=https://replace-with-your-cloudflare-access-issuer
SMART_SEND_ACCESS_AUD=replace-with-your-cloudflare-access-audience
SMART_SEND_OWNER_MAP={"operator@example.com":"local-preview-user"}
# Somente desenvolvimento via localhost; nunca habilitar em hospedagem.
SMART_SEND_ALLOW_LOCAL=false
SMART_SEND_FILE_BYTES=4194304
SMART_SEND_BATCH_FILES=100
SMART_SEND_MAX_PAGES=50
SMART_SEND_DRAFT_HOURS=24
SMART_SEND_RETENTION_DAYS=30
SMART_SEND_INTERVAL_SECONDS=60
